# Postgres connection string (database must have the pgvector extension available).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_memory

# Static bearer token, an alternative to OAuth for Claude Code and scripts ("Authorization: Bearer <token>").
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-long-random-string

# Passphrase you type on the OAuth sign-in page (e.g. when connecting from claude.ai). Use a long one.
OWNER_PASSWORD=replace-with-a-long-passphrase

# Optional: public origin used as the OAuth issuer. Defaults to https://$RAILWAY_PUBLIC_DOMAIN on Railway,
# otherwise http://localhost:$PORT.
# PUBLIC_URL=https://memory.example.com

# API key for the embeddings endpoint (an OpenRouter key by default).
EMBEDDING_API_KEY=replace-me

# Optional: any OpenAI-compatible embeddings endpoint (default: https://openrouter.ai/api/v1).
# Set https://api.openai.com/v1 to use OpenAI directly.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# Optional: embedding model (default: openai/text-embedding-3-small).
EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: embedding vector size (default: 1536). Fixed when the table is first created.
EMBEDDING_DIMENSIONS=1536

# Optional: caps on core memories, which load into every conversation (defaults: 20 memories, 4000 characters total).
# CORE_MEMORY_MAX_COUNT=20
# CORE_MEMORY_MAX_CHARS=4000

# Optional: HTTP port (default: 3000). Railway sets this automatically.
PORT=3000
